<% is_me = message.sender_id == current_user.id %>
<div class="flex <%= is_me ? "justify-end" : "justify-start" %>">
  <div class="<%= is_me ? "bg-sky-500/15 text-sky-100" : "bg-white/10 text-zinc-100" %>
              inline-flex flex-col max-w-[100%] rounded-2xl px-4 py-3">
    <% if message.body.present? %>
      <div class="text-sm leading-relaxed"><%= message.body %></div>
    <% end %>

    <% if message.media.attached? %>
      <% media_images = message.media.select { |m| m.content_type&.start_with?("image/") } %>
      <% media_videos = message.media.select { |m| m.content_type&.start_with?("video/") } %>

      <% if media_images.any? %>
        <div class="mt-3 flex flex-wrap gap-2">
          <% media_images.each do |img| %>
            <button
              type="button"
              class="group relative h-44 w-32 overflow-hidden rounded-xl ring-1 ring-white/10 transition hover:ring-white/30"
              data-action="click->message-media#open"
              data-url="<%= url_for(img) %>"
              data-type="image">
              <%= image_tag img,
                class: "h-full w-full object-cover transition duration-200 group-hover:scale-[1.03]" %>
            </button>
          <% end %>
        </div>
      <% end %>

      <% if media_videos.any? %>
        <div class="mt-3 flex flex-wrap gap-2">
          <% media_videos.each do |vid| %>
            <button
              type="button"
              class="group relative h-44 w-32 overflow-hidden rounded-xl ring-1 ring-white/10 transition hover:ring-sky-300/40"
              data-action="click->message-media#open"
              data-url="<%= url_for(vid) %>"
              data-type="video">
              <%= video_tag vid,
                class: "h-full w-full object-cover",
                muted: true,
                loop: true,
                autoplay: true,
                playsinline: true %>
              <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/55 via-black/10 to-transparent"></span>
              <span class="pointer-events-none absolute bottom-2 right-2 grid h-7 w-7 place-items-center rounded-full bg-black/60 text-white/90 ring-1 ring-white/30">
                ▶
              </span>
            </button>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
