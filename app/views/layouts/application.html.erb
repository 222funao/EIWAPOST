

<!DOCTYPE html>
<html lang="es">
  <head>
    <title>EIWAPOST</title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <!-- Tailwind / CSS -->
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= favicon_link_tag 'favicon.ico' %>

</head>
  <body class="min-h-screen w-full overflow-x-hidden <%= theme_class %>"
        data-controller="<%= ["user-search", "notifications-panel", ("presence" if user_signed_in?)].compact.join(" ") %>"
        data-user-search-posts-url-value="<%= feed_path %>"
        <% if user_signed_in? %>
        data-presence-user-id-value="<%= current_user.id %>"
        data-presence-heartbeat-url-value="<%= presence_heartbeat_path %>"
        data-presence-offline-url-value="<%= presence_offline_path %>"
        <% end %>>
    <% if user_signed_in? %>
      <%= turbo_stream_from(*Notification.stream_for(current_user)) %>
    <% end %>
    <%= yield %>
    <%= render "shared/user_search_modal" %>
    <%= render "shared/notifications_panel" %>
    <% if user_signed_in? %>
      <%= render "shared/quick_notifications", notifications: Notification.for_user(current_user).recent_first.limit(5).includes(:actor, :notifiable) %>
    <% end %>
  </body>
</html>
