<div data-group-edit-target="modal" class="hidden fixed inset-0 z-[120]">
  <div data-action="click->group-edit#close"
       class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <div class="absolute left-1/2 top-6 max-h-[88vh] w-[92vw] max-w-[620px] -translate-x-1/2
              rounded-3xl border border-white/10 bg-zinc-900/35 shadow-2xl overflow-hidden">

    <div class="flex items-center justify-between px-5 py-4 border-b border-white/10">
      <div class="text-lg font-semibold text-white">Editar grupo</div>
      <button type="button"
              data-action="click->group-edit#close"
              class="rounded-lg px-2 py-1 text-zinc-400 hover:bg-white/5 hover:text-white">
        X
      </button>
    </div>

    <div class="max-h-[calc(88vh-68px)] overflow-y-auto p-5 space-y-6">
      <% if can_manage_group || group.allow_member_edit? %>
        <%= form_with model: group, url: group_path(group), method: :patch,
          html: { multipart: true },
          class: "space-y-4" do |f| %>
          
          <div class="space-y-3">
            <div>
              <%= f.label :name, "Nombre", class: "block text-xs text-zinc-400" %>
              <%= f.text_field :name, required: true, disabled: !can_manage_group && !group.allow_member_edit?,
                class: "mt-2 w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3
                        text-sm text-zinc-100 placeholder:text-zinc-500 outline-none
                        focus:border-white/20 focus:ring-2 focus:ring-white/10" %>
            </div>
            <div>
              <div class="block text-xs text-zinc-400">Foto del grupo</div>
              <%= f.file_field :avatar, disabled: !can_manage_group && !group.allow_member_edit?,
                accept: "image/*",
                class: "mt-2 block w-full text-xs text-zinc-300 file:mr-3 file:rounded-full file:border file:border-white/10 file:bg-white/5 file:px-4 file:py-2 file:text-xs file:text-zinc-200 file:transition file:hover:bg-white/10" %>
            </div>
          </div>

          <% if can_manage_group %>
            <div class="space-y-3">
              <div class="text-xs font-semibold text-zinc-400">Permisos</div>
              <label class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-zinc-200">
                <%= f.check_box :allow_member_edit,
                  class: "h-4 w-4 rounded border-white/20 bg-white/5 text-sky-400 focus:ring-0" %>
                Permitir que cualquier miembro edite nombre y foto
              </label>
            </div>
          <% end %>

          <div>
            <%= f.submit "Guardar cambios", disabled: !can_manage_group && !group.allow_member_edit?,
              class: "rounded-full border border-emerald-300/25 bg-gradient-to-br from-emerald-500/25 to-teal-400/15 px-4 py-2 text-xs font-semibold text-emerald-100 shadow-[0_6px_24px_rgba(16,185,129,0.25)] transition hover:scale-105 hover:from-emerald-500/35 hover:to-teal-400/25" %>
          </div>
        <% end %>

        <% if can_manage_group %>
          <div class="space-y-3">
            <div class="text-xs font-semibold text-zinc-400">Agregar miembros</div>
            <% if available_friends.any? %>
              <%= form_with url: group_group_memberships_path(group), method: :post, class: "flex items-center gap-3" do |membership_form| %>
                <%= select_tag "group_membership[user_id]",
                  options_from_collection_for_select(available_friends, :id, :username),
                  class: "flex-1 rounded-2xl border border-white/10 bg-white/5 px-8 py-2 text-sm text-zinc-100 outline-none" %>
                <%= membership_form.submit "Agregar",
                  class: "rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs text-zinc-200 transition hover:bg-white/10" %>
              <% end %>
            <% else %>
              <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-zinc-500">
                No hay mas amigos para agregar.
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <div class="space-y-3">
        <div class="flex items-center justify-between">
          <div class="text-xs font-semibold text-zinc-400">Miembros</div>
          <% current_membership = group_memberships.find { |m| m.user_id == current_user.id } %>
          <% if current_membership %>
            <%= button_to "Salir del grupo",
              group_group_membership_path(group, current_membership, self: 1),
              method: :delete,
              class: "rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-zinc-200 transition hover:bg-white/10" %>
          <% end %>
        </div>
        <% leaders_count = group_memberships.count { |m| m.leader? } %>
        <div class="space-y-2">
          <% group_memberships.each do |membership| %>
            <div class="flex items-center justify-between rounded-2xl border border-white/10 bg-white/5 px-4 py-2">
              <div class="flex items-center gap-3">
                <div class="h-9 w-9 overflow-hidden rounded-full bg-zinc-800 ring-1 ring-white/10">
                  <% if membership.user.avatar.attached? %>
                    <%= image_tag membership.user.avatar, class: "h-full w-full object-cover" %>
                  <% else %>
                    <%= image_tag "avatars/default.png", class: "h-full w-full object-cover opacity-90" %>
                  <% end %>
                </div>
                <div>
                  <div class="text-sm font-semibold text-zinc-100"><%= membership.user.username %></div>
                  <div class="text-xs text-zinc-500"><%= membership.leader? ? "Lider" : "Miembro" %></div>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <% if can_manage_group && membership.member? %>
                  <%= button_to "Hacer lider",
                    group_group_membership_path(group, membership, group_membership: { role: "leader" }),
                    method: :patch,
                    class: "rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-zinc-200 transition hover:bg-white/10" %>
                <% end %>
                <% if can_manage_group %>
                  <% can_remove = !membership.leader? || leaders_count > 1 %>
                  <%= button_to "Eliminar",
                    group_group_membership_path(group, membership),
                    method: :delete,
                    disabled: !can_remove,
                    class: "rounded-full border border-rose-500/20 bg-rose-500/10 px-3 py-1 text-xs text-rose-100 transition hover:bg-rose-500/20 #{can_remove ? '' : 'opacity-50 cursor-not-allowed'}" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

