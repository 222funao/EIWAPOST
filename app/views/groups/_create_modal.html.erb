<div data-group-wizard-target="modal" class="hidden fixed inset-0 z-[120]">
  <div data-action="click->group-wizard#close"
       class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <div class="absolute left-1/2 top-10 w-[92vw] max-w-[560px] -translate-x-1/2
              rounded-3xl border border-white/10 bg-zinc-900/35 shadow-2xl overflow-hidden">

    <div class="flex items-center justify-between px-5 py-4 border-b border-white/10">
      <div class="text-lg font-semibold text-white">Nuevo grupo</div>
      <button type="button"
              data-action="click->group-wizard#close"
              class="rounded-lg px-2 py-1 text-zinc-400 hover:bg-white/5 hover:text-white">
        X
      </button>
    </div>

    <%= form_with model: Group.new, url: groups_path, method: :post,
      html: { multipart: true },
      data: { action: "turbo:submit-end->group-wizard#reset" } do |f| %>
      <div class="p-5 space-y-4">
        <div data-group-wizard-target="stepSelect" class="space-y-4">
          <div class="text-xs font-semibold text-zinc-400">Elige amigos</div>

          <% if friends.any? %>
            <div class="max-h-[360px] overflow-y-auto pr-1 space-y-2">
              <% friends.each do |friend| %>
                <label class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-3 py-2">
                  <%= check_box_tag "group[member_ids][]", friend.id, false,
                    data: { action: "group-wizard#toggleSelection" },
                    class: "h-4 w-4 rounded border-white/20 bg-white/5 text-sky-400 focus:ring-0" %>
                  <div class="h-9 w-9 overflow-hidden rounded-full bg-zinc-800 ring-1 ring-white/10">
                    <% if friend.avatar.attached? %>
                      <%= image_tag friend.avatar, class: "h-full w-full object-cover" %>
                    <% else %>
                      <%= image_tag "avatars/default.png", class: "h-full w-full object-cover opacity-90" %>
                    <% end %>
                  </div>
                  <div class="text-sm font-semibold text-zinc-100"><%= friend.username %></div>
                </label>
              <% end %>
            </div>

            <div class="flex items-center justify-between text-xs text-zinc-400">
              <div><span data-group-wizard-target="count">0</span> seleccionados</div>
              <button
                type="button"
                data-action="group-wizard#next"
                data-group-wizard-target="nextButton"
                class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs text-zinc-200 transition hover:bg-white/10">
                Siguiente
              </button>
            </div>
          <% else %>
            <div class="rounded-2xl border border-white/10 bg-white/5 px-4 py-6 text-center text-sm text-zinc-500">
              Aun no tienes amigos para crear un grupo.
            </div>
          <% end %>
        </div>

        <div data-group-wizard-target="stepDetails" class="hidden space-y-4">
          <div class="text-xs font-semibold text-zinc-400">Detalles del grupo</div>
          <div class="space-y-3">
            <div>
              <%= f.label :name, "Nombre", class: "block text-xs text-zinc-400" %>
              <%= f.text_field :name, required: true,
                class: "mt-2 w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3
                        text-sm text-zinc-100 placeholder:text-zinc-500 outline-none
                        focus:border-white/20 focus:ring-2 focus:ring-white/10" %>
            </div>
            <div>
              <%= f.label :avatar, "Foto del grupo", class: "block text-xs text-zinc-400" %>
              <%= f.file_field :avatar,
                accept: "image/*",
                class: "mt-2 block w-full text-xs text-zinc-300" %>
            </div>
          </div>

          <div class="flex items-center justify-between">
            <button
              type="button"
              data-action="group-wizard#back"
              class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs text-zinc-200 transition hover:bg-white/10">
              Volver
            </button>
            <%= f.submit "Crear grupo",
              class: "rounded-full border border-emerald-300/25 bg-gradient-to-br from-emerald-500/25 to-teal-400/15 px-4 py-2 text-xs font-semibold text-emerald-100 shadow-[0_6px_24px_rgba(16,185,129,0.25)] transition hover:scale-105 hover:from-emerald-500/35 hover:to-teal-400/25" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

