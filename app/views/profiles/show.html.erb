<div data-controller="profile-follows" class="min-h-screen w-full text-zinc-100 app-bg">
  <div class="w-full px-0">
    <div class="grid min-h-screen grid-cols-1 gap-0 lg:grid-cols-[96px_1fr]">

      <!-- Sidebar: mismo comportamiento -->
      <%= render "shared/sidebar" %>

      <!-- Main -->
      <main class="py-8 px-6 lg:px-10">
        <div class="mx-auto w-full max-w-[980px]">

          <!-- HEADER PERFIL -->
          <div class="flex flex-col gap-6 md:flex-row md:items-center">

            <!-- Avatar -->
            <div data-controller="avatar-picker" class="shrink-0">
              <% if @is_owner %>
                <%= form_with model: @user, url: profile_path, method: :patch,
                      html: { multipart: true, class: "inline" } do |f| %>

                  <%= f.file_field :avatar,
                    class: "hidden",
                    data: { avatar_picker_target: "input", action: "change->avatar-picker#submit" } %>

                  <div class="relative h-28 w-28">
                    <button type="button"
                      data-action="click->avatar-picker#pick"
                      class="relative h-28 w-28 rounded-full bg-zinc-800 overflow-hidden ring-2 ring-white/10 hover:ring-white/20 transition">
                      <% if @user.avatar.attached? %>
                        <%= image_tag @user.avatar, class: "h-full w-full object-cover" %>
                      <% else %>
                        <%= image_tag "avatars/default.png", class: "h-full w-full object-cover opacity-90" %>
                      <% end %>

                      <div class="absolute inset-0 grid place-items-center bg-black/0 hover:bg-black/35 transition">
                        <div class="rounded-full bg-black/40 px-3 py-2 text-sm text-white opacity-0 hover:opacity-100 transition">
                          📷 Cambiar
                        </div>
                      </div>
                    </button>
                    <%= render "shared/presence_dot", user: @user, size_class: "h-5 w-5", border_class: "border-[3px]", offset_class: "-bottom-0.5 -right-0.5" %>
                  </div>

                <% end %>
              <% else %>
                <div class="relative h-28 w-28">
                  <div class="h-28 w-28 rounded-full bg-zinc-800 overflow-hidden ring-2 ring-white/10">
                    <% if @user.avatar.attached? %>
                      <%= image_tag @user.avatar, class: "h-full w-full object-cover" %>
                    <% else %>
                      <%= image_tag "avatars/default.png", class: "h-full w-full object-cover opacity-90" %>
                    <% end %>
                  </div>
                  <%= render "shared/presence_dot", user: @user, size_class: "h-5 w-5", border_class: "border-[3px]", offset_class: "-bottom-0.5 -right-0.5" %>
                </div>
              <% end %>
            </div>

            <!-- Info derecha -->
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-3">
                <div class="text-xl font-semibold"><%= @user.username %></div>

                <% if @is_owner %>
                  <%= link_to "Editar perfil",
                    edit_user_registration_path,
                    class: "rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-zinc-100
                            hover:bg-white/10 active:scale-[0.99] transition" %>

                  <%= form_with model: @user, url: profile_path, method: :patch, class: "inline-flex items-center" do |f| %>
                    <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-xs font-semibold text-zinc-200 hover:bg-white/10">
                      <%= f.check_box :invisible,
                        checked: @user.invisible?,
                        class: "peer sr-only",
                        onchange: "this.form.requestSubmit()" %>
                      <span class="relative h-5 w-9 rounded-full bg-zinc-700/80 transition peer-checked:bg-sky-500/70 before:absolute before:left-0.5 before:top-0.5 before:h-4 before:w-4 before:rounded-full before:bg-white before:transition-transform peer-checked:before:translate-x-4"></span>
                      Invisible
                    </label>
                  <% end %>
                <% else %>
                  <%= render "users/follow_button", user: @user %>

                  <% if current_user.friends_with?(@user) %>
                    <%= link_to "Enviar mensaje",
                      messages_path(user_id: @user.id),
                      class: "rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-xs font-semibold text-zinc-100
                              hover:bg-white/10 active:scale-[0.99] transition" %>
                  <% end %>
                <% end %>
              </div>

              <!-- Stats -->
              <div class="mt-4 flex gap-6 text-sm items-center">
                <button type="button"
                        class="cursor-default rounded-lg px-2 py-1">
                  <span class="font-semibold"><%= @posts.size %></span> publicaciones
                </button>

                <button type="button"
                        data-action="click->profile-follows#openFollowers"
                        class="cursor-pointer rounded-lg px-2 py-1 hover:bg-white/5 hover:text-white">
                  <%= render "profiles/followers_count", user: @user %>
                </button>
                <button type="button"
                        data-action="click->profile-follows#openFollowing"
                        class="cursor-pointer rounded-lg px-2 py-1 hover:bg-white/5 hover:text-white">
                  <%= render "profiles/following_count", user: @user %>
                </button>
              </div>


              <!-- Bio -->
              <div class="mt-4 max-w-[520px]">
                <% if @is_owner %>
                  <%= form_with model: @user, url: profile_path, method: :patch do |f| %>
                    <div class="flex flex-col gap-2">
                      <%= f.text_area :bio,
                        rows: 3,
                        placeholder: "Escribe tu biografía…",
                        class: "w-full resize-none rounded-2xl border border-white/10 bg-zinc-900/30 px-4 py-3 text-sm text-zinc-100 placeholder:text-zinc-500 outline-none focus:border-white/20 focus:ring-2 focus:ring-white/10" %>

                      <div class="flex items-center gap-2">
                        <%= f.submit "Guardar",
                          class: "rounded-xl bg-white px-4 py-2 text-sm font-semibold text-zinc-950 hover:bg-zinc-100 active:scale-[0.99]" %>

                        <% if flash[:notice].present? %>
                          <div class="text-xs text-zinc-400"><%= flash[:notice] %></div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                <% else %>
                  <% if @user.bio.present? %>
                    <div class="rounded-2xl border border-white/10 bg-zinc-900/20 px-4 py-3 text-sm text-zinc-200">
                      <%= simple_format(@user.bio) %>
                    </div>
                  <% else %>
                    <div class="text-sm text-zinc-500">Sin biografía.</div>
                  <% end %>
                <% end %>
              </div>

            </div>
          </div>

          <!-- TABS -->
          <div data-controller="profile-tabs" class="mt-10">
            <div class="flex items-center justify-center gap-10 border-t border-white/10 pt-4 text-sm">
              <button type="button"
                data-action="click->profile-tabs#showPosts"
                data-profile-tabs-target="tabPosts"
                class="flex items-center gap-2 text-zinc-200">
                ⬛ Publicaciones
              </button>

              <button type="button"
                data-action="click->profile-tabs#showLiked"
                data-profile-tabs-target="tabLiked"
                class="flex items-center gap-2 text-zinc-500 hover:text-zinc-200">
                ❤️ Likeadas
              </button>
            </div>

            <!-- GRID POSTS -->
            <section
              data-profile-tabs-target="panelPosts"
              class="mt-6 transition-opacity duration-200 ease-out opacity-100"
            >
              <% if @posts.any? %>
                <div class="grid grid-cols-2 gap-3">
                  <% @posts.each do |post| %>
                    <%= render "profiles/post_tile", post: post %>
                  <% end %>
                </div>
              <% else %>
                <div class="mt-12 text-center text-zinc-400">
                  Este usuario aún no ha publicado nada.
                </div>
              <% end %>
            </section>

            <!-- GRID LIKEADAS -->
            <section
              data-profile-tabs-target="panelLiked"
              class="mt-6 transition-opacity duration-200 ease-out hidden opacity-0"
            >
              <% if @liked_posts.any? %>
                <div class="grid grid-cols-2 gap-3">
                  <% @liked_posts.each do |post| %>
                    <%= render "profiles/post_tile", post: post %>
                  <% end %>
                </div>
              <% else %>
                <div class="mt-12 text-center text-zinc-400">
                  Este usuario aún no ha dado like a ninguna publicación.
                </div>
              <% end %>
            </section>

          </div>

        </div>
      </main>
    </div>
    <%= render "shared/user_search_modal" %>

    <div data-profile-follows-target="followersModal" class="hidden fixed inset-0 z-[140]">
  <div data-action="click->profile-follows#closeFollowers" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
  <div class="relative z-10 mx-auto mt-24 w-full max-w-md px-4">
    <div data-modal-card class="rounded-3xl border border-white/10 bg-zinc-900/35 p-5 shadow-2xl">
      <div class="mb-4 flex items-center justify-between">
        <div class="text-base font-semibold text-white">Seguidores</div>
        <button type="button"
                data-action="click->profile-follows#closeFollowers"
                class="rounded-full bg-white/5 px-3 py-1 text-xs text-zinc-300 hover:bg-white/10">
          Cerrar
        </button>
      </div>
      <div class="max-h-[60vh] overflow-y-auto pr-1">
        <% @user.followers.each do |follower| %>
          <%= link_to public_profile_path(follower), class: "flex items-center gap-3 rounded-xl px-2 py-2 hover:bg-white/5" do %>
            <% if follower.avatar.attached? %>
              <%= image_tag follower.avatar, class: "h-9 w-9 rounded-full object-cover ring-1 ring-white/10" %>
            <% else %>
              <%= image_tag "avatars/default.png", class: "h-9 w-9 rounded-full object-cover ring-1 ring-white/10" %>
            <% end %>
            <span class="text-sm text-zinc-100 hover:underline"><%= follower.username %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

    <div data-profile-follows-target="followingModal" class="hidden fixed inset-0 z-[140]">
  <div data-action="click->profile-follows#closeFollowing" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
  <div class="relative z-10 mx-auto mt-24 w-full max-w-md px-4">
    <div data-modal-card class="rounded-3xl border border-white/10 bg-zinc-900/35 p-5 shadow-2xl">
      <div class="mb-4 flex items-center justify-between">
        <div class="text-base font-semibold text-white">Seguidos</div>
        <button type="button"
                data-action="click->profile-follows#closeFollowing"
                class="rounded-full bg-white/5 px-3 py-1 text-xs text-zinc-300 hover:bg-white/10">
          Cerrar
        </button>
      </div>
      <div class="max-h-[60vh] overflow-y-auto pr-1">
        <% @user.following.each do |followed| %>
          <%= link_to public_profile_path(followed), class: "flex items-center gap-3 rounded-xl px-2 py-2 hover:bg-white/5" do %>
            <% if followed.avatar.attached? %>
              <%= image_tag followed.avatar, class: "h-9 w-9 rounded-full object-cover ring-1 ring-white/10" %>
            <% else %>
              <%= image_tag "avatars/default.png", class: "h-9 w-9 rounded-full object-cover ring-1 ring-white/10" %>
            <% end %>
            <span class="text-sm text-zinc-100 hover:underline"><%= followed.username %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
  </div>
</div>



