<div class="rounded-xl overflow-hidden bg-zinc-900/30 border border-white/10">
  <% if post.media.attached? %>

    <% if post.media.count == 1 %>
      <% file = post.media.first %>

      <div class="relative aspect-square bg-black overflow-hidden">
        <% if file.content_type.start_with?("image/") %>
          <%= image_tag file, class: "absolute inset-0 h-full w-full object-cover" %>
        <% else %>
          <div class="video-wrapper absolute inset-0">
            <%= video_tag url_for(file),
              class: "h-full w-full object-cover",
              autoplay: true,
              loop: true,
              muted: true,
              playsinline: true,
              data: { video: true } %>

            <button type="button"
              class="mute-btn absolute right-2 bottom-2 rounded-full bg-black/50 px-2.5 py-1.5 text-white text-xs hover:bg-black/70">
              🔇
            </button>
          </div>
        <% end %>
      </div>

    <% else %>
      <!-- Carrusel mini dentro del grid -->
      <div data-controller="carousel" class="relative group aspect-square bg-black overflow-hidden">
        <div data-carousel-target="track" class="flex h-full w-full overflow-hidden scroll-smooth">
          <% post.media.each do |file| %>
            <div class="relative h-full w-full shrink-0">
              <% if file.content_type.start_with?("image/") %>
                <%= image_tag file, class: "absolute inset-0 h-full w-full object-cover" %>
              <% else %>
                <div class="video-wrapper absolute inset-0">
                  <%= video_tag url_for(file),
                    class: "h-full w-full object-cover",
                    autoplay: true,
                    loop: true,
                    muted: true,
                    playsinline: true,
                    data: { video: true } %>

                  <button type="button"
                    class="mute-btn absolute right-2 bottom-2 rounded-full bg-black/50 px-2.5 py-1.5 text-white text-xs hover:bg-black/70">
                    🔇
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Botones mini -->
        <button type="button"
          data-action="click->carousel#prev"
          class="absolute left-2 top-1/2 z-10 -translate-y-1/2
                 flex h-8 w-8 items-center justify-center rounded-full
                 bg-black/45 text-white backdrop-blur
                 shadow-md transition opacity-0 group-hover:opacity-100 hover:bg-black/65">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button type="button"
          data-action="click->carousel#next"
          class="absolute right-2 top-1/2 z-10 -translate-y-1/2
                 flex h-8 w-8 items-center justify-center rounded-full
                 bg-black/45 text-white backdrop-blur
                 shadow-md transition opacity-0 group-hover:opacity-100 hover:bg-black/65">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <!-- Dots mini -->
        <div class="absolute bottom-2 left-0 right-0 flex justify-center gap-1.5">
          <% post.media.count.times do |i| %>
            <button type="button"
              data-carousel-target="dot"
              data-action="click->carousel#go"
              data-carousel-index-param="<%= i %>"
              class="h-1.5 w-1.5 rounded-full bg-white opacity-40">
            </button>
          <% end %>
        </div>
      </div>
    <% end %>

  <% else %>
    <div class="aspect-square bg-zinc-800"></div>
  <% end %>
</div>
