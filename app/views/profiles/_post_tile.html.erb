<%= link_to post_path(post), class: "block rounded-xl overflow-hidden bg-zinc-900/30 border border-white/10 hover:border-white/20 transition" do %>
  <% if post.media.attached? %>
    <% file = post.media.first %>

    <div class="relative aspect-square bg-black overflow-hidden">
      <% if file.content_type.start_with?("image/") %>
        <%= image_tag file, class: "absolute inset-0 h-full w-full object-cover" %>
      <% else %>
        <%= video_tag url_for(file),
          class: "absolute inset-0 h-full w-full object-cover",
          muted: true,
          playsinline: true %>
        <div class="absolute inset-0 bg-black/20"></div>
        <div class="absolute bottom-2 right-2 rounded-full bg-black/60 px-2 py-1 text-[10px] text-white">
          VIDEO
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="aspect-square bg-zinc-800"></div>
  <% end %>
<% end %>
