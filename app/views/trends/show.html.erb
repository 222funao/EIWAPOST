<div class="min-h-screen w-full text-zinc-100 app-bg">
  <div class="w-full pr-6 lg:pr-12 2xl:pr-6 pl-0">
    <div class="grid min-h-screen grid-cols-1 gap-0 lg:grid-cols-[96px_1fr_340px]">
      <%= render "shared/sidebar" %>

      <main class="py-6 pl-10 pr-10 lg:pl-29 lg:pr-4">
        <section class="mx-auto w-full max-w-[920px] space-y-6">
          <div class="rounded-2xl border border-white/10 bg-zinc-900/30 p-5">
            <div class="text-xl font-semibold">#<%= @trend.name %></div>
            <div class="mt-1 text-sm text-zinc-400">
              <%= pluralize(@posts.size, "publicacion", "publicaciones") %>
            </div>
          </div>

          <% if @posts.any? %>
            <%= render partial: "posts/feed_post", collection: @posts, as: :post %>
          <% else %>
            <div class="rounded-2xl border border-white/10 bg-zinc-900/30 p-5 text-sm text-zinc-400">
              No hay publicaciones para este hashtag.
            </div>
          <% end %>
        </section>
      </main>

      <aside class="sticky top-0 hidden h-screen bg-transparent py-6 pl-6 pr-8 lg:block w-[380px]">
        <div class="space-y-4">
          <div class="rounded-2xl border border-white/10 bg-zinc-900/30 p-4">
            <div class="text-sm font-semibold text-zinc-200">Tendencias</div>
            <div class="mt-3 space-y-3">
              <% @top_trends.each do |trend| %>
                <%= link_to trend_path(trend.name), class: "block rounded-xl px-3 py-2 hover:bg-white/5" do %>
                  <div class="text-sm font-medium text-zinc-100">#<%= trend.name %></div>
                  <div class="text-xs text-zinc-400"><%= trend.posts_count %> publicaciones</div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>

