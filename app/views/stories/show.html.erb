<div class="min-h-screen w-full bg-zinc-950 text-zinc-100">
  <div class="w-full pr-6 lg:pr-12 2xl:pr-6 pl-0">
    <div class="grid min-h-screen grid-cols-1 gap-0 lg:grid-cols-[96px_1fr_340px]">
      <%= render "shared/sidebar" %>

      <main class="relative py-6 pl-10 pr-10 lg:pl-29 lg:pr-4">
        <section
          data-controller="stories-viewer"
          data-stories-viewer-stories-value="<%= json_escape(@stories_data.to_json) %>"
          data-stories-viewer-image-duration-value="5000"
          data-stories-viewer-current-user-id-value="<%= current_user.id %>"
          data-stories-viewer-start-story-id-value="<%= @story.id %>"
          data-stories-viewer-auto-open-value="true"
          data-stories-viewer-close-url-value="<%= root_path %>"
          data-stories-viewer-messages-path-template-value="<%= user_messages_path('USER_ID') %>"
          data-stories-viewer-story-like-path-template-value="<%= story_like_path('STORY_ID') %>"
          class="relative">

          <div data-stories-viewer-target="modal" class="fixed inset-0 z-[200]">
            <div data-action="click->stories-viewer#close"
                 class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>

            <div class="relative z-10 mx-auto flex h-full max-w-[980px] items-center justify-center px-4">
              <button type="button"
                      data-action="click->stories-viewer#prev"
                      class="absolute left-0 top-0 h-full w-1/3 z-10"></button>
              <button type="button"
                      data-action="click->stories-viewer#next"
                      class="absolute right-0 top-0 h-full w-1/3 z-10"></button>

              <button type="button"
                      data-action="click->stories-viewer#prev"
                      class="absolute left-4 top-1/2 z-30 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/40 text-white shadow-lg backdrop-blur transition hover:scale-105 hover:bg-black/60">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6" />
                </svg>
              </button>
              <button type="button"
                      data-action="click->stories-viewer#next"
                      class="absolute right-4 top-1/2 z-30 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/40 text-white shadow-lg backdrop-blur transition hover:scale-105 hover:bg-black/60">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" />
                </svg>
              </button>

              <div class="relative w-full max-w-[380px]">
                <div class="absolute right-0 top-[-46px] flex items-center gap-2">
                  <%= link_to root_path,
                    class: "rounded-full bg-white/10 px-3 py-2 text-sm text-white hover:bg-white/20" do %>
                    X
                  <% end %>
                </div>

                <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-black shadow-2xl">
                  <div class="absolute left-0 right-0 top-0 z-20 px-3 pt-3">
                    <div data-stories-viewer-target="progress" class="flex gap-1"></div>
                                          <div class="mt-3 flex items-center justify-between text-white">
                        <div class="flex items-center gap-2">
                          <img data-stories-viewer-target="avatar" class="h-9 w-9 rounded-full object-cover" alt="" />
                          <div class="text-sm font-semibold" data-stories-viewer-target="username"></div>
                          <div data-stories-viewer-target="time" class="rounded-full bg-black/40 px-2.5 py-1 text-sm text-white/95"></div>
                        </div>
                        <div class="flex items-center gap-2">
                          <button type="button"
                                  data-stories-viewer-target="pauseToggle"
                                  data-action="click->stories-viewer#togglePause"
                                  class="rounded-full bg-black/40 px-2.5 py-1.5 text-sm text-white/95 hover:bg-black/60">
                            ⏸
                          </button>
                          <button type="button"
                                  data-stories-viewer-target="soundToggle"
                                  data-action="click->stories-viewer#toggleSound"
                                  class="rounded-full bg-black/40 px-2.5 py-1.5 text-sm text-white/95 hover:bg-black/60">
                            🔊
                          </button>
                        </div>
                      </div>
                  </div>

                  <div class="relative aspect-[9/16] w-full bg-black">
                    <img data-stories-viewer-target="image" class="hidden h-full w-full object-contain" alt="" />
                    <video data-stories-viewer-target="video"
                           class="hidden h-full w-full object-contain"
                           playsinline></video>

                    <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20">
                      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-black/70 via-black/35 to-transparent"></div>
                      <div class="relative px-6 pb-20 pt-10 text-center">
                        <div data-stories-viewer-target="description" class="mx-auto inline-block max-w-[280px] rounded-xl bg-black/40 px-3 py-1.5 text-sm text-white/95"></div>
                      </div>
                    </div>

                    <div class="absolute inset-x-0 bottom-0 z-30 px-3 pb-3">
                      <div class="flex items-center gap-2">
                        <form data-stories-viewer-target="replyForm"
                              data-action="submit->stories-viewer#submitReply"
                              class="flex-1">
                          <div class="flex items-center gap-2 rounded-full border border-white/10 bg-black/40 px-3 py-1.5 backdrop-blur">
                            <input data-stories-viewer-target="replyInput"
                                   type="text"
                                   name="message[body]"
                                   autocomplete="off"
                                   placeholder="Escribe una respuesta..."
                                   class="w-full bg-transparent text-sm text-white placeholder:text-white/60 outline-none" />
                            <input data-stories-viewer-target="replyStoryId"
                                   type="hidden"
                                   name="story_id"
                                   value="" />
                          <div class="relative">
                              <button type="submit" class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white hover:bg-white/20">
                                Enviar
                              </button>
                              <span data-stories-viewer-target="replyIndicator"
                                    class="pointer-events-none absolute -right-1 -top-1 h-2.5 w-2.5 rounded-full bg-emerald-400/80 opacity-0 scale-75 transition duration-300"></span>
                            </div>
                          </div>
                        </form>
                        <button type="button"
                                data-stories-viewer-target="likeButton"
                                data-action="click->stories-viewer#toggleLike"
                                class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-black/40 text-white/90 hover:bg-black/60">
                          <span data-stories-viewer-target="likeIcon" class="text-base leading-none">🤍</span>
                          <span data-stories-viewer-target="likeIconFilled" class="hidden text-base leading-none">❤️</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </main>

      <aside class="sticky top-0 hidden h-screen bg-zinc-950 py-6 pl-6 pr-8 lg:block w-[380px]"></aside>
    </div>
  </div>
</div>






