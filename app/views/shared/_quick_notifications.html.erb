<div data-controller="quick-notifications"
     data-action="pointermove->quick-notifications#drag pointerup->quick-notifications#endDrag pointercancel->quick-notifications#endDrag"
     class="fixed bottom-6 right-6 z-[120] touch-none">
  <button type="button"
          data-action="pointerdown->quick-notifications#startDrag pointerup->quick-notifications#endDrag pointercancel->quick-notifications#endDrag"
          data-quick-notifications-target="button"
          class="relative flex h-12 w-12 items-center justify-center rounded-full bg-zinc-900/90 text-white shadow-lg ring-1 ring-white/10 backdrop-blur hover:bg-zinc-800">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.4-1.4a2 2 0 0 1-.6-1.4V11a6 6 0 0 0-12 0v3.2a2 2 0 0 1-.6 1.4L4 17h5" />
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a3 3 0 0 0 6 0" />
    </svg>
    <span data-quick-notifications-target="ping"
          class="pointer-events-none absolute -right-1 -top-1 h-3 w-3 rounded-full bg-rose-500/90 opacity-0"></span>
  </button>

  <div data-quick-notifications-target="panel"
       class="pointer-events-none absolute bottom-14 right-0 w-80 max-w-[90vw] translate-y-2 opacity-0 transition duration-200">
    <div class="rounded-2xl border border-white/10 bg-zinc-950/95 p-3 shadow-2xl">
      <div class="mb-2 text-xs font-semibold text-zinc-400">Notificaciones</div>
      <div id="quick_notifications_list" data-quick-notifications-target="list" class="space-y-2">
        <%= render partial: "shared/quick_notifications_list", locals: { notifications: local_assigns.fetch(:notifications, []) } %>
      </div>
    </div>
  </div>
</div>
