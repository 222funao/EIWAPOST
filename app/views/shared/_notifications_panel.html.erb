<div data-notifications-panel-target="modal" class="hidden fixed inset-0 z-[110]">
  <div data-action="click->notifications-panel#close"
       class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <div class="absolute left-0 top-0 h-full w-[440px] max-w-[92vw]
              border-r border-white/10 bg-zinc-950/95 shadow-2xl">
    <div class="flex items-center justify-between px-5 py-4 border-b border-white/10">
      <div class="text-lg font-semibold text-white">Notificaciones</div>
      <button type="button"
              data-action="click->notifications-panel#close"
              class="rounded-lg px-2 py-1 text-zinc-400 hover:bg-white/5 hover:text-white">
        ✕
      </button>
    </div>

    <div class="h-full overflow-y-auto px-4 pb-6 pt-4">
      <% if @notifications.blank? %>
        <div class="py-10 text-center text-sm text-zinc-500">No hay notificaciones.</div>
      <% else %>
        <% now = Time.current %>
        <% today_start = now.beginning_of_day %>
        <% recent_cutoff = 5.days.ago.beginning_of_day %>

        <% today_items = @notifications.select { |n| (n.updated_at || n.created_at) >= today_start } %>
        <% recent_items = @notifications.select { |n| (n.updated_at || n.created_at) < today_start && (n.updated_at || n.created_at) >= recent_cutoff } %>
        <% old_items = @notifications.select { |n| (n.updated_at || n.created_at) < recent_cutoff } %>

        <% if today_items.any? %>
          <div class="mb-3 text-xs font-semibold text-zinc-400">Hoy</div>
          <div class="space-y-3 mb-6">
            <% today_items.each do |notification| %>
              <%= render partial: "shared/notification_item", locals: { notification: notification } %>
            <% end %>
          </div>
        <% end %>

        <% if recent_items.any? %>
          <div class="mb-3 text-xs font-semibold text-zinc-400">Recientes</div>
          <div class="space-y-3 mb-6">
            <% recent_items.each do |notification| %>
              <%= render partial: "shared/notification_item", locals: { notification: notification } %>
            <% end %>
          </div>
        <% end %>

        <% if old_items.any? %>
          <div class="mb-3 text-xs font-semibold text-zinc-400">Antiguos</div>
          <div class="space-y-3">
            <% old_items.each do |notification| %>
              <%= render partial: "shared/notification_item", locals: { notification: notification } %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
