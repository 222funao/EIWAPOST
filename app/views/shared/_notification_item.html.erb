<div class="flex items-center justify-between gap-3 rounded-xl px-2 py-2 hover:bg-white/5">
  <div class="flex items-center gap-3 min-w-0">
    <% if notification.actor&.avatar&.attached? %>
      <%= image_tag rails_blob_path(notification.actor.avatar, only_path: true), class: "h-9 w-9 rounded-full object-cover ring-1 ring-white/10" %>
    <% else %>
      <%= image_tag "avatars/default.png", class: "h-9 w-9 rounded-full object-cover ring-1 ring-white/10" %>
    <% end %>

    <div class="min-w-0 text-sm text-zinc-200">
      <div class="truncate">
        <% if notification.group_count.to_i > 1 && %w[like comment].include?(notification.action) %>
          <span><%= notification_message(notification) %></span>
        <% else %>
          <%= notification_actor_link(notification) %>
          <span> <%= notification_message(notification) %></span>
        <% end %>
      </div>
      <div class="text-xs text-zinc-500">
        hace <%= time_ago_in_words(notification.updated_at || notification.created_at, locale: :es) %>
      </div>
    </div>
  </div>

  <% preview = notification_post_preview(notification) %>
  <% if preview %>
    <%= preview %>
  <% end %>
</div>
