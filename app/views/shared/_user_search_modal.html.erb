<div data-user-search-target="modal" class="hidden fixed inset-0 z-[100]">
  <div data-action="click->user-search#close"
       class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

  <div class="absolute left-1/2 top-10 w-[92vw] max-w-[520px] -translate-x-1/2
              rounded-3xl border border-white/10 bg-zinc-950/90 shadow-2xl overflow-hidden">

    <div class="flex items-center justify-between px-5 py-4 border-b border-white/10">
      <div class="text-lg font-semibold text-white">Buscar</div>
      <button type="button"
              data-action="click->user-search#close"
              class="rounded-lg px-2 py-1 text-zinc-400 hover:bg-white/5 hover:text-white">
        ✕
      </button>
    </div>

    <div class="p-5 space-y-4">
      <div class="relative">
        <input
          data-user-search-target="input"
          data-action="input->user-search#search keydown.enter->user-search#filterPosts"

          type="text"
          placeholder="Buscar"
          value="<%= @query %>"
          class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3
                 text-sm text-zinc-100 placeholder:text-zinc-500 outline-none
                 focus:border-white/20 focus:ring-2 focus:ring-white/10" />

        <button type="button"
                data-action="click->user-search#clear"
                class="absolute right-3 top-1/2 -translate-y-1/2
                       rounded-full px-2 py-1 text-zinc-400 hover:bg-white/10">
          ✕
        </button>
      </div>

      <div class="text-xs font-semibold text-zinc-400">Usuarios</div>

      <div data-user-search-target="results"
           class="max-h-[420px] overflow-y-auto pr-1 space-y-2">
        <div class="py-10 text-center text-sm text-zinc-500">
         Escribe algo para buscar usuarios.
        </div>
      </div>
    </div>
  </div>
</div>
