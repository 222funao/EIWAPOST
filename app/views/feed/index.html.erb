<div class="min-h-screen w-full text-zinc-100 app-bg">
  <div class="w-full pr-6 lg:pr-12 2xl:pr-6 pl-0">

    <div class="grid min-h-screen grid-cols-1 gap-0 lg:grid-cols-[96px_1fr_340px]">

       <%= render "shared/sidebar" %>

      <!-- Centro: Historias + Posts -->
      <main class="py-6 pl-10 pr-10 lg:pl-29 lg:pr-4">


        <% if @story_groups.present? %>
          <!-- Historias -->
          <section
            data-controller="stories-viewer"
            data-stories-viewer-stories-value="<%= json_escape(@stories_data.to_json) %>"
            data-stories-viewer-image-duration-value="5000"
            data-stories-viewer-current-user-id-value="<%= current_user.id %>"
            data-stories-viewer-messages-path-template-value="<%= user_messages_path('USER_ID') %>"
            data-stories-viewer-story-like-path-template-value="<%= story_like_path('STORY_ID') %>"
            style="--story-count: <%= @story_groups.size %>; width: min(100%, calc(var(--story-count) * 96px + 72px));"
            class="rounded-2xl border border-white/10 bg-zinc-900/30 p-0 mx-auto w-full">
           

            <div data-stories-viewer-target="list" class="mt-4 flex gap-4 overflow-x-auto pb-2 justify-center">
              <% @story_groups.each_with_index do |(user, stories), idx| %>
                <button
                  type="button"
                  data-action="click->stories-viewer#open"
                  data-stories-viewer-user-id-param="<%= user.id %>"
                  data-story-user-id="<%= user.id %>"
                  class="flex w-20 flex-col items-center gap-2">
                  <div data-story-ring class="rounded-full bg-gradient-to-tr from-fuchsia-500 via-rose-500 to-amber-400 p-[2px]">
                    <div class="h-16 w-16 rounded-full bg-zinc-950 p-[2px]">
                      <div class="h-full w-full overflow-hidden rounded-full bg-zinc-800">
                        <% if user.avatar.attached? %>
                          <%= image_tag user.avatar, class: "h-full w-full object-cover" %>
                        <% else %>
                          <%= image_tag "avatars/default.png", class: "h-full w-full object-cover" %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                  <div class="w-full truncate text-center text-xs text-zinc-300"><%= user.username %></div>
                </button>
              <% end %>
            </div>

            <!-- Viewer -->
            <div data-stories-viewer-target="modal" class="hidden fixed inset-0 z-[9999]">
              <div data-action="click->stories-viewer#close"
                   class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>

              <div class="relative z-10 mx-auto flex h-full max-w-[980px] items-center justify-center px-4">
                <button type="button"
                        data-action="click->stories-viewer#prev"
                        class="absolute left-0 top-0 h-full w-1/3 z-10"></button>
                <button type="button"
                        data-action="click->stories-viewer#next"
                        class="absolute right-0 top-0 h-full w-1/3 z-10"></button>

                <button type="button"
                        data-action="click->stories-viewer#prev"
                        class="absolute left-4 top-1/2 z-30 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/30 text-white shadow-lg backdrop-blur transition hover:scale-105 hover:bg-black/45">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6" />
                  </svg>
                </button>
                <button type="button"
                        data-action="click->stories-viewer#next"
                        class="absolute right-4 top-1/2 z-30 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/30 text-white shadow-lg backdrop-blur transition hover:scale-105 hover:bg-black/45">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6" />
                  </svg>
                </button>

                <div class="relative w-full max-w-[380px]">
                  <div class="absolute right-0 top-[-46px] flex items-center gap-2">
                    <button type="button"
                            data-action="click->stories-viewer#close"
                            class="rounded-full bg-white/10 px-3 py-2 text-sm text-white hover:bg-white/20">
                      ✕
                    </button>
                  </div>

                  <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-black shadow-2xl">
                    <div class="absolute left-0 right-0 top-0 z-20 px-3 pt-3">
                      <div data-stories-viewer-target="progress" class="flex gap-1"></div>
                      <div class="mt-3 flex items-center justify-between text-white">
  <div class="flex items-center gap-2">
    <img data-stories-viewer-target="avatar" class="h-9 w-9 rounded-full object-cover" alt="" />
    <div class="text-sm font-semibold" data-stories-viewer-target="username"></div>
    <div data-stories-viewer-target="time" class="rounded-full bg-black/30 px-2.5 py-1 text-sm text-white/95"></div>
  </div>
  <div class="flex items-center gap-2">
    <button type="button"
            data-stories-viewer-target="pauseToggle"
            data-action="click->stories-viewer#togglePause"
            class="rounded-full bg-black/30 px-2.5 py-1.5 text-sm text-white/95 hover:bg-black/45">
      ⏸
    </button>
    <button type="button"
            data-stories-viewer-target="soundToggle"
            data-action="click->stories-viewer#toggleSound"
            class="rounded-full bg-black/30 px-2.5 py-1.5 text-sm text-white/95 hover:bg-black/45">
      🔊
    </button>
  </div>
</div>
                    </div>

                    <div class="relative aspect-[9/16] w-full bg-black">
                      <img data-stories-viewer-target="image" class="hidden h-full w-full object-contain" alt="" />
                      <video data-stories-viewer-target="video"
                             class="hidden h-full w-full object-contain"
                             playsinline></video>

                      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20">
                        <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-black/70 via-black/35 to-transparent"></div>
                        <div class="relative px-6 pb-20 pt-10 text-center">
                          <div data-stories-viewer-target="description" class="mx-auto inline-block max-w-[280px] rounded-xl bg-black/30 px-3 py-1.5 text-sm text-white/95"></div>
                        </div>
                      </div>

                      <div data-stories-viewer-target="replyBar" class="absolute inset-x-0 bottom-0 z-30 px-3 pb-3">
                        <div class="flex items-center gap-2">
                          <form data-stories-viewer-target="replyForm"
                                data-action="submit->stories-viewer#submitReply"
                                class="flex-1">
                            <div class="flex items-center gap-2 rounded-full border border-white/10 bg-black/30 px-3 py-1.5 backdrop-blur">
                              <input data-stories-viewer-target="replyInput"
                                     type="text"
                                     name="message[body]"
                                     autocomplete="off"
                                     placeholder="Escribe una respuesta..."
                                     class="w-full bg-transparent text-sm text-white placeholder:text-white/60 outline-none" />
                              <input data-stories-viewer-target="replyStoryId"
                                     type="hidden"
                                     name="story_id"
                                     value="" />
                              <div class="relative">
                                <button type="submit" class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white hover:bg-white/20">
                                  Enviar
                                </button>
                                <span data-stories-viewer-target="replyIndicator"
                                      class="pointer-events-none absolute -right-1 -top-1 h-2.5 w-2.5 rounded-full bg-emerald-400/80 opacity-0 scale-75 transition duration-300"></span>
                              </div>
                            </div>
                          </form>
                          <button type="button"
                                  data-stories-viewer-target="likeButton"
                                  data-action="click->stories-viewer#toggleLike"
                                  class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-black/30 text-white/90 hover:bg-black/45">
                            <span data-stories-viewer-target="likeIcon" class="text-base leading-none">🤍</span>
                            <span data-stories-viewer-target="likeIconFilled" class="hidden text-base leading-none">❤️</span>
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>
        <% end %>

<!-- Posts -->
<section class="mt-6 space-y-6 mx-auto w-full max-w-[920px]">
  <% @posts.each do |post| %>

    <!-- Contenedor: post + panel comentarios -->
    <div data-controller="post-comments"
     class="relative lg:flex lg:items-stretch lg:justify-center">

      <!-- Post (ancho fijo, no se encoge) -->
      <div data-post-comments-target="post" class="lg:w-[520px] lg:shrink-0 transition-transform duration-300 ease-out">
        <article class="overflow-hidden rounded-2xl border border-white/10 bg-zinc-900/30">
          <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-3">
              <div class="h-9 w-9 overflow-hidden rounded-full bg-zinc-800 ring-1 ring-white/10">
  <% if post.user.avatar.attached? %>
    <%= image_tag post.user.avatar, class: "h-full w-full object-cover" %>
  <% else %>
    <%= image_tag "avatars/default.png", class: "h-full w-full object-cover" %>
  <% end %>
</div>


              <div>
                <div class="text-base font-semibold"><%= link_to post.user.username,
            public_profile_path(post.user),
            class: "hover:underline" %></div>
                <div class="text-xs text-zinc-400">
                  <%= link_to "hace #{time_ago_in_words(post.created_at, locale: :es)}", post_path(post), class: "hover:underline" %>
                </div>
              </div>
            </div>
            <button class="rounded-lg px-2 py-1 text-zinc-400 hover:bg-white/5 hover:text-white">⋯</button>
          </div>

          <!-- Media -->
          <% if post.media.attached? %>
            <% if post.media.count == 1 %>
              <% file = post.media.first %>

              <div class="relative w-full overflow-hidden bg-black aspect-[6/7]">
                <% if file.content_type.start_with?("image/") %>
                  <%= image_tag file, class: "absolute inset-0 h-full w-full object-cover" %>
                <% else %>
                  <div class="video-wrapper absolute inset-0">
                    <%= video_tag url_for(file),
                      class: "h-full w-full object-cover",
                      autoplay: true,
                      loop: true,
                      muted: true,
                      playsinline: true,
                      data: { video: true } %>

                    <button type="button"
                      class="mute-btn absolute right-3 bottom-3 rounded-full bg-black/35 px-3 py-2 text-white hover:bg-black/70">
                      🔇
                    </button>
                  </div>
                <% end %>
              </div>

            <% else %>
              <!-- Carrusel -->
              <div data-controller="carousel" class="relative group">
                <div data-carousel-target="track" class="flex w-full overflow-hidden scroll-smooth">
                  <% post.media.each do |file| %>
                    <div class="w-full shrink-0" data-slide>
                      <div class="relative w-full overflow-hidden bg-black aspect-[6/7]">
                        <% if file.content_type.start_with?("image/") %>
                          <%= image_tag file, class: "absolute inset-0 h-full w-full object-cover" %>
                        <% else %>
                          <div class="video-wrapper absolute inset-0">
                            <%= video_tag url_for(file),
                              class: "h-full w-full object-cover",
                              autoplay: true,
                              loop: true,
                              muted: true,
                              playsinline: true,
                              data: { video: true } %>

                            <button type="button"
                              class="mute-btn absolute right-3 bottom-3 rounded-full bg-black/35 px-3 py-2 text-white hover:bg-black/70">
                              🔇
                            </button>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>

                <!-- Botones carrusel -->
                <button type="button"
                  data-action="click->carousel#prev"
                  class="carousel-btn absolute left-3 top-1/2 z-10 -translate-y-1/2
                        flex h-9 w-9 items-center justify-center
                        rounded-full bg-black/35 text-white shadow-lg
                        backdrop-blur
                        transition-all duration-200 ease-out hover:scale-105 hover:bg-zinc-600/90 active:scale-95
                        opacity-0 group-hover:opacity-100">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                  </svg>
                </button>

                <button type="button"
                  data-action="click->carousel#next"
                  class="carousel-btn absolute right-3 top-1/2 z-10 -translate-y-1/2
                        flex h-9 w-9 items-center justify-center
                        rounded-full bg-black/35 text-white shadow-lg
                        backdrop-blur
                        transition-all duration-200 ease-out hover:scale-105 hover:bg-zinc-600/90 active:scale-95
                        opacity-0 group-hover:opacity-100">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </button>

                <!-- Dots -->
                <div class="absolute bottom-3 left-0 right-0 flex justify-center gap-2">
                  <% post.media.count.times do |i| %>
                    <button type="button"
                      data-carousel-target="dot"
                      data-action="click->carousel#go"
                      data-carousel-index-param="<%= i %>"
                      class="h-2 w-2 rounded-full bg-white opacity-40">
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>

          <!-- Caption + acciones -->
          <div class="px-4 py-3">
            <% if post.caption.present? %>
              <div class="text-base text-zinc-200">
                <span class="font-semibold"><%= link_to post.user.username,
            public_profile_path(post.user),
            class: "hover:underline" %></span>
                <%= render_with_mentions(post.caption) %>
              </div>
            <% end %>

            <!-- Botón comentarios -->


<div class="mt-3 flex items-center gap-3">
  <%= render "posts/like_button", post: post %>


<% base = "hover:scale-[1.05] active:scale-[0.95] inline-flex items-center gap-2 rounded-xl px-3 py-1.5 text-lg leading-none hover:bg-white/10 transition text-zinc-300 hover:text-white" %>

<button type="button"
  data-action="click->post-comments#toggle"
  class="<%= base %>">

  <span class="leading-none">💬</span>

  <span
    id="comments_count_post_<%= post.id %>"
    class="text-sm leading-none">
    <%= post.comments_count || post.comments.size %>
  </span>

</button>




          </div>
        </article>
      </div>

      <!-- Panel comentarios (derecha) -->
      <aside
  data-post-comments-target="panel"
  class="hidden lg:flex lg:flex-col
         absolute top-0 right-0 h-full
         overflow-hidden rounded-2xl border bg-zinc-900/30
         transition-all duration-300 ease-out
         lg:w-0 lg:opacity-0 lg:border-transparent
         pointer-events-none">


        <div class="flex items-center justify-between px-4 py-3">
          <div class="text-sm font-semibold text-zinc-200">Comentarios</div>
          <button type="button"
            data-action="click->post-comments#toggle"
            class="rounded-lg px-2 py-1 text-zinc-400 hover:bg-white/5 hover:text-white">✕</button>
        </div>

        <!-- lista comentarios -->
        <div class="comments-scroll flex-1 min-h-0 px-4 pb-3 overflow-y-auto">

          <div id="comments_list_post_<%= post.id %>" class="space-y-1 pr-1">
            <% post.comments.order(created_at: :asc).each do |comment| %>
              <div id="<%= dom_id(comment) %>" class="flex items-start justify-between gap-3 py-2">
                <div class="min-w-0">
                  <div class="flex items-start gap-2 min-w-0">
                    <span class="h-5 w-5 shrink-0 overflow-hidden rounded-full bg-zinc-800 ring-1 ring-white/10">
                      <% if comment.user.avatar.attached? %>
                        <%= image_tag comment.user.avatar, class: "h-full w-full object-cover" %>
                      <% else %>
                        <%= image_tag "avatars/default.png", class: "h-full w-full object-cover" %>
                      <% end %>
                    </span>
                    <div class="min-w-0 text-sm leading-snug">
                      <%= link_to comment.user.username,
                        public_profile_path(comment.user),
                        class: "font-semibold text-zinc-200 hover:underline" %>
                      <span class="text-zinc-300 break-words"><%= render_with_mentions(comment.body) %></span>
                    </div>
                  </div>
                </div>

                <% if comment.user_id == current_user.id %>
                  <%= button_to "Eliminar",
                    post_comment_path(post, comment),
                    method: :delete,
                    form: { data: { turbo_confirm: "¿Eliminar comentario?" } },
                    class: "shrink-0 rounded-lg px-2 py-1 text-xs text-zinc-400 hover:bg-white/5 hover:text-white" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- form -->
        <div class="mt-auto border-t border-white/10 px-4 py-3">
          <div id="comment_form_post_<%= post.id %>">
            <%= form_with model: [post, Comment.new], class: "flex items-center gap-2" do |f| %>
              <%= f.text_field :body,
                placeholder: "Escribe un comentario...",
                class: "w-full rounded-xl border border-white/10 bg-zinc-950/40 px-4 py-3 text-sm text-zinc-100 placeholder:text-zinc-600 outline-none focus:border-white/20 focus:ring-2 focus:ring-white/10" %>

              <%= f.submit "Enviar",
                class: "rounded-xl bg-white px-4 py-3 text-sm font-semibold text-zinc-950 hover:bg-zinc-100 active:scale-[0.99]" %>
            <% end %>
          </div>
        </div>
      </aside>

    </div>
  <% end %>
</section>


      </main>

      <!-- Derecha: perfil + sugerencias -->
      <aside class="sticky top-0 hidden h-screen bg-transparent py-6 pl-6 pr-8 lg:block w-[380px]">

        <div class="space-y-4">
          <!-- Perfil -->
          <div class="rounded-2xl border border-white/10 bg-zinc-900/30 p-4">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="h-10 w-10 overflow-hidden rounded-full bg-zinc-800 ring-1 ring-white/10">
  <% if current_user.avatar.attached? %>
    <%= image_tag current_user.avatar, class: "h-full w-full object-cover" %>
  <% else %>
    <%= image_tag "avatars/default.png", class: "h-full w-full object-cover" %>
  <% end %>
</div>

                <div>
                  <div class="text-sm font-semibold"><%= current_user.username %></div>
                  <div class="text-xs text-zinc-400"><%= current_user.email %></div>
                </div>
              </div>

              
            </div>
          </div>

          <!-- Sugerencias -->
          

          <div class="px-1 text-xs text-zinc-500">
            © <%= Time.current.year %> EIWAPOST
          </div>
        </div>
      </aside>
    </div>
  </div>

</div>
</div>



